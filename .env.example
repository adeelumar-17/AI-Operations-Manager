# ─────────────────────────────────────────────────────────────────────────────
# AI Operations Manager — Environment Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database Connection Strings ───────────────────────────────────────────────
# Neon (serverless Postgres — recommended for production / AWS Lambda / Neon dev):
#
# 1. DATABASE_URL: POOLED connection string (for running app / FastAPI / Lambda)
#    Neon Console -> Connection Details -> Check "Pooled connection"
DATABASE_URL=postgresql+psycopg://<username>:<password>@<ep-name>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require

# 2. DATABASE_URL_DIRECT: DIRECT unpooled connection string (for Alembic migrations)
#    Neon Console -> Connection Details -> Uncheck "Pooled connection"
DATABASE_URL_DIRECT=postgresql+psycopg://<username>:<password>@<ep-name>.<region>.aws.neon.tech/<dbname>?sslmode=require



# ── Embeddings — runs locally, no API key needed ──────────────────────────────
# Model: all-MiniLM-L6-v2 → 384-dimensional vectors (matches VECTOR(384) in DB)
EMBEDDING_BACKEND=sentence-transformers
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
# HF_TOKEN=hf_your_token_here   # Optional: Hugging Face read token for higher rate limits



# ── Groq LLM — get your free key at console.groq.com ─────────────────────────
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=1.0
GROQ_MAX_TOKENS=2048
GROQ_REASONING_EFFORT=medium


# ── Scheduler ─────────────────────────────────────────────────────────────────
# Set to "true" to run APScheduler in-process (local dev).
# Set to "false" on Lambda — EventBridge triggers /internal/run-followups instead.
SCHEDULER_ENABLED=true

# Secret header value required to hit POST /internal/run-followups.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SCHEDULER_SECRET=change-me-to-a-random-secret