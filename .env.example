# ─────────────────────────────────────────────────────────────────────────────
# AI Operations Manager — Environment Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ── Local PostgreSQL (docker-compose dev only) ────────────────────────────────
POSTGRES_DB=ai_operations_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Database URL ──────────────────────────────────────────────────────────────
# Local dev (docker-compose):
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ai_operations_manager

# Production (Neon — use the POOLED connection string to handle Lambda concurrency):
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require


# ── Embeddings — runs locally, no API key needed ──────────────────────────────
# Model: all-MiniLM-L6-v2 → 384-dimensional vectors (matches VECTOR(384) in DB)
EMBEDDING_BACKEND=sentence-transformers
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2


# ── Groq LLM — get your free key at console.groq.com ─────────────────────────
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=1.0
GROQ_MAX_TOKENS=2048
GROQ_REASONING_EFFORT=medium


# ── Scheduler ─────────────────────────────────────────────────────────────────
# Set to "true" to run APScheduler in-process (local dev).
# Set to "false" on Lambda — EventBridge triggers /internal/run-followups instead.
SCHEDULER_ENABLED=true

# Secret header value required to hit POST /internal/run-followups.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SCHEDULER_SECRET=change-me-to-a-random-secret